{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "esaa://templates/event.schema.json",
  "title": "ESAA Activity Event Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_seq",
    "ts",
    "actor",
    "action",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "event_seq": { "type": "integer", "minimum": 1 },
    "ts": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "runner": { "type": ["object", "string", "null"] },
    "reviewer_role": { "type": "string", "minLength": 1 },
    "prev_event_hash": { "type": ["string", "null"] },
    "event_hash": { "type": "string", "minLength": 1 },
    "projection_hash_after": { "type": "string", "minLength": 1 },
    "projector_version": { "type": "string", "minLength": 1 },
    "action": {
      "type": "string",
      "enum": [
        "verification.configure",
        "verification.run",
        "run.start",
        "run.end",
        "task.create",
        "task.amend",
        "task.release",
        "task.limits.set",
        "claim",
        "complete",
        "review",
        "issue.report",
        "hotfix.create",
        "issue.resolve",
        "runner.metrics",
        "project.profile.set",
        "chain.anchor",
        "snapshot.anchor",
        "actor.bootstrap",
        "actor.register",
        "actor.bind_alias",
        "output.rejected",
        "orchestrator.file.write",
        "orchestrator.view.mutate",
        "verify.start",
        "verify.ok",
        "verify.fail",
        "plugin.install",
        "plugin.remove",
        "plugin.update",
        "roadmap.activate",
        "roadmap.pause",
        "roadmap.resume",
        "roadmap.deactivate",
        "contract.set"
      ]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "verification.configure" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "profile": { "type": "string" },
              "checks": { "type": ["array", "object"] },
              "commands": { "type": ["array", "object"] },
              "timeout_seconds": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "verification.run" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["run_id"],
            "properties": {
              "run_id": { "type": "string", "minLength": 1 },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "run.start" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "project": { "type": "string" },
              "run_id": { "type": "string" },
              "verify_status": { "type": "string" },
              "source_mode": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "run.end" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "task.create" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id", "title"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "task_kind": { "type": "string" },
              "description": { "type": "string" },
              "targets": { "type": "array" },
              "depends_on": { "type": "array" },
              "outputs": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "task.amend" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "depends_on": { "type": "array" },
              "outputs": { "type": "object" },
              "boundary_grant": { "type": ["array", "object", "null"] },
              "resource_limits": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "task.release" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" },
              "expected_revision": { "type": ["integer", "null"] },
              "previous": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "task.limits.set" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "resource_limits": { "type": "object" },
              "resolved_resource_limits": { "type": "object" },
              "reason": { "type": "string" },
              "authorized_by": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "claim" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "prior_status": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "complete" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "prior_status": { "type": "string" },
              "notes": { "type": "string" },
              "verification": { "type": "object" },
              "issue_id": { "type": "string" },
              "fixes": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "review" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id", "decision"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "decision": { "type": "string", "minLength": 1 },
              "prior_status": { "type": "string" },
              "notes": { "type": "string" },
              "verification": { "type": "object" },
              "tasks": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "issue.report" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["issue_id"],
            "properties": {
              "issue_id": { "type": "string", "minLength": 1 },
              "task_id": { "type": ["string", "null"] },
              "title": { "type": "string" },
              "severity": { "type": "string" },
              "evidence": { "type": ["string", "object", "array"] },
              "affected": { "type": ["array", "object"] },
              "fixes": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "hotfix.create" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id", "issue_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "issue_id": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "fixes": { "type": "string" },
              "is_hotfix": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "issue.resolve" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["issue_id"],
            "properties": {
              "issue_id": { "type": "string", "minLength": 1 },
              "resolution": { "type": ["string", "object"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "runner.metrics" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "project.profile.set" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "chain.anchor" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["anchored_through_seq", "anchor_sha256"],
            "properties": {
              "anchored_through_seq": { "type": "integer", "minimum": 0 },
              "anchor_sha256": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "snapshot.anchor" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "snapshot_path",
              "before_event_seq",
              "snapshot_hash_sha256",
              "tail_offset_bytes",
              "last_covered_event_seq",
              "projector_version"
            ],
            "properties": {
              "snapshot_path": { "type": "string", "minLength": 1 },
              "before_event_seq": { "type": "integer", "minimum": 0 },
              "snapshot_hash_sha256": { "type": "string", "minLength": 1 },
              "tail_offset_bytes": { "type": "integer", "minimum": 0 },
              "last_covered_event_seq": { "type": "integer", "minimum": 0 },
              "last_covered_event_hash": { "type": ["string", "null"] },
              "projector_version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "actor.bootstrap" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["alg", "public_key_hex", "fingerprint_sha256", "authorization"],
            "properties": {
              "alg": { "type": "string", "minLength": 1 },
              "public_key_hex": { "type": "string", "minLength": 1 },
              "fingerprint_sha256": { "type": "string", "minLength": 1 },
              "authorization": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "actor.register" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["authorization"],
            "properties": {
              "authorization": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "actor.bind_alias" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["authorization"],
            "properties": {
              "authorization": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "output.rejected" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["error_code", "message"],
            "properties": {
              "error_code": { "type": "string", "minLength": 1 },
              "message": { "type": "string" },
              "source_action": { "type": ["string", "null"] },
              "source_actor": { "type": ["string", "null"] },
              "task_id": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "orchestrator.file.write" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "files": { "type": "array" },
              "effects": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "orchestrator.view.mutate" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["target"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "change": { "type": "string" },
              "lessons": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "verify.start" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "strict": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "verify.ok" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["projection_hash_sha256"],
            "properties": {
              "projection_hash_sha256": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "verify.fail" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "verify_status": { "type": "string" },
              "error_code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "plugin.install" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["id", "name", "version", "source", "content_hash", "manifest_path"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "content_hash": { "type": "string", "minLength": 1 },
              "manifest_path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "plugin.update" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["id", "version", "source", "content_hash", "manifest_path"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "content_hash": { "type": "string", "minLength": 1 },
              "manifest_path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "plugin.remove" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["plugin_id"],
            "properties": {
              "plugin_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "roadmap.activate" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["plugin_id", "execution_id", "roadmap", "content_hash", "status"],
            "properties": {
              "plugin_id": { "type": "string", "minLength": 1 },
              "plugin_version": { "type": "string" },
              "execution_id": { "type": "string", "minLength": 1 },
              "roadmap": { "type": "string", "minLength": 1 },
              "input": { "type": ["string", "null"] },
              "input_hash": { "type": ["string", "null"] },
              "content_hash": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "roadmap.pause" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["plugin_id", "execution_id"],
            "properties": {
              "plugin_id": { "type": "string", "minLength": 1 },
              "execution_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "roadmap.resume" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["plugin_id", "execution_id"],
            "properties": {
              "plugin_id": { "type": "string", "minLength": 1 },
              "execution_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "roadmap.deactivate" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["plugin_id", "execution_id"],
            "properties": {
              "plugin_id": { "type": "string", "minLength": 1 },
              "execution_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "contract.set" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["contract", "sha256"],
            "properties": {
              "contract": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "source": { "type": "string" },
              "previous_sha256": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  ]
}
